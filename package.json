{
  "name": "krakow-bus-map",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Interactive map of Kraków public transport (KMK) — GTFS + OSM + HMM map matching",
  "scripts": {
    "download": "bash pipeline/download.sh",
    "prebuild": "node pipeline/snapshot.mjs --archive",
    "build": "node --max-old-space-size=6144 pipeline/build.mjs --all --tram \"$(python3 pipeline/tram-lines.py data/gtfs-t data/osm/krakow-tram.json --list)\"",
    "postbuild": "node pipeline/snapshot.mjs --stamp",
    "report": "node pipeline/report-gaps.mjs",
    "serve": "node pipeline/serve.mjs 8124",
    "lines": "node pipeline/lines.mjs",
    "audit": "node --max-old-space-size=6144 pipeline/audit.mjs",
    "schematic": "node --max-old-space-size=4096 pipeline/schematic/build-schematic.mjs",
    "snapshot": "node pipeline/snapshot.mjs"
  }
}
